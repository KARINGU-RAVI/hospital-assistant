# Copy this file to .env and type your own values there. Never commit .env.

# --- Model keys ---
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# --- Model chain (tried in order; later: bedrock,gemini,groq,openrouter) ---
MODEL_CHAIN=gemini,groq,openrouter
GEMINI_MODEL_ID=gemini-3.5-flash-lite
GROQ_MODEL_ID=openai/gpt-oss-120b
OPENROUTER_MODEL_ID=               # pick a model that supports tool calling; empty = skipped
BEDROCK_MODEL_ID=apac.amazon.nova-lite-v1:0

# --- History sent to the model each call (free-tier TPM limits; full history stays in the UI) ---
HISTORY_MAX_MESSAGES=6
HISTORY_MAX_TOKENS=3000             # approximate (characters / 4)

# --- AWS ---
AWS_REGION=ap-south-1

# --- Bedrock Guardrails (Phase 4) ---
GUARDRAILS_ENABLED=false
GUARDRAIL_ID=
GUARDRAIL_VERSION=DRAFT

# --- AgentCore Memory (Phase 4) ---
MEMORY_ENABLED=false
MEMORY_ID=

# --- RAG (Phase 3): vector | keyword ---
RAG_MODE=vector

# --- App (Phase 5): local | cloud ---
APP_MODE=local
LOCAL_AGENT_URL=http://localhost:8080/invocations
AGENT_RUNTIME_ARN=

# --- Paths (defaults are fine) ---
DB_PATH=data/hospital.db
CHROMA_PATH=data/chroma
FAQ_PATH=data/faq
